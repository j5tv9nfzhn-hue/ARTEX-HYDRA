# Docker 部署配置：复制为 .env 后填写。
# ARTEX_TAG 对应 docker-compose 使用的上游镜像 autumn27/artex。
# 该上游镜像的可用性不由本分支保证，原分支曾记录拉取失败。
# 如无法获取镜像，请按 README 的源码单二进制流程构建；
# 上游预编译镜像不保证包含本分支的语言与安全改动。
ARTEX_TAG=latest

# 存储只有 SQLite：一个文件，没有数据库服务、没有 POSTGRES_* 变量。
# 容器里把库文件放在持久化卷上，否则重建容器就丢数据。
# 留空则用镜像默认路径（配置目录旁的 artex.db）。
ARTEX_SQLITE_PATH=/data/artex.db

# LLM：填写任意一项或两项，也可留空，稍后在 UI 配置。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 首次运行保护，避免管理员账户被远程抢先初始化。
# - Web/API 默认仅绑定宿主 127.0.0.1；其他设备需要直连时可改为 0.0.0.0，
#   但必须先完成初始设置，之后建议使用 HTTPS 反向代理。
# - 首次启动会打印随机设置令牌，可通过 docker compose logs artex 查看。
#   在 /setup 输入此值，才能创建管理员密码。
#   ARTEX_SETUP_TOKEN 非空时使用指定令牌，不会在日志打印。
# - ARTEX_ADMIN_PASSWORD 非空时直接初始化，跳过 /setup，至少八个字符。
ARTEX_BIND=127.0.0.1
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
# 浏览器 CORS 允许列表，以逗号分隔；内嵌 UI 同源，通常留空。
ARTEX_CORS_ORIGINS=

# 服务端默认输出语言：zh（简体中文），另支持 en、es；旧 ko 自动归一为 zh。
# - Agent 报告、摘要、对话与后端消息使用此默认值，设置页的输出语言优先。
# - 服务端控制台日志仅遵循此值或 config.json，不受浏览器语言选择影响。
# - Web UI 的显示语言是浏览器本地偏好，默认简体中文。
ARTEX_LANG=zh
