          "description": "原始请求文本，例如 `GET /api/x HTTP/1.1` + 换行 + `Host: example.com` + 空行 + body",
          "type": "string"
        }
      },
      "required": [
        "request"
      ],
      "type": "object"
    }
  },
  {
    "name": "http_fuzz",
    "title": "",
    "description": "把一个请求模板里的 FUZZ 占位符逐个替换成载荷并发发送，与基线比对状态/长度，可正则提取命中。适合参数、头、路径的批量试探。",
    "tier": "L2",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": true,
    "schema": {
      "properties": {
        "base_url": {
          "description": "可选，scheme://host",
          "type": "string"
        },
        "concurrency": {
          "description": "并发，默认 16，上限 32",
          "type": "integer"
        },
        "insecure": {
          "description": "跳过 TLS 校验，默认 true",
          "type": "boolean"
        },
        "match": {
          "description": "可选正则，命中则标记 MATCH，并在结果里列出第一个匹配",
          "type": "string"
        },
        "max_body": {
          "description": "每条响应读取的最大字节，默认 200000",
          "type": "integer"
        },
        "payloads": {
          "description": "载荷列表",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "request": {
          "description": "请求模板，必须包含 FUZZ 占位符（会出现多次则同时替换）",
          "type": "string"
        }
      },
      "required": [
        "request",
        "payloads"
      ],
      "type": "object"
    }
  },
  {
    "name": "dir_probe",
    "title": "",
    "description": "路径枚举：把内置或自定义字典拼到 URL 后面并发请求，按状态码/长度过滤。只做 GET，不跟随跳转。",
    "tier": "L2",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": true,
    "schema": {
      "properties": {
        "concurrency": {
          "description": "并发，默认 24，上限 64",
          "type": "integer"
        },
        "extensions": {
          "description": "附加后缀，例如 ['.php','.bak']",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "insecure": {
          "description": "跳过 TLS 校验，默认 true",
          "type": "boolean"
        },
        "status": {
          "description": "关心的状态码，默认 [200,204,301,302,307,401,403]",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "url": {
          "description": "基地址，例如 https://example.com",
          "type": "string"
        },
        "wordlist": {
          "description": "自定义路径列表；为空用内置常见路径",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    }
  },
  {
    "name": "param_probe",
    "title": "",
    "description": "参数反射与行为差异探测：对单个查询参数注入随机 canary，检查是否原样回显在正文/响应头，以及长度与状态是否变化。",
    "tier": "L2",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": true,
