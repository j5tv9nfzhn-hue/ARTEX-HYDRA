        },
        "server_name": {
          "description": "SNI，缺省用 host",
          "type": "string"
        },
        "target": {
          "description": "host:port，端口缺省 443",
          "type": "string"
        },
        "timeout_ms": {
          "description": "超时毫秒，默认 8000",
          "type": "integer"
        }
      },
      "required": [
        "target"
      ],
      "type": "object"
    }
  },
