[
  {
    "name": "file_identify",
    "title": "",
    "description": "按魔数判断文件类型（PE/ELF/Mach-O/ZIP/APK/PDF/OLE/压缩包），给出大小、时间与 MD5/SHA256。",
    "tier": "L0",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "schema": {
      "properties": {
        "path": {
          "description": "样本绝对路径或工作目录相对路径",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    }
  },
  {
    "name": "pe_info",
    "title": "",
    "description": "解析 PE：架构、子系统、时间戳、入口点、节表与每节熵、导入库、导出符号。用于判断编译器/加壳与攻击面。",
    "tier": "L0",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "schema": {
      "properties": {
        "max_imps": {
          "description": "最多列出多少个导入符号，默认 60",
          "type": "integer"
        },
        "path": {
          "description": "PE 文件路径",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    }
  },
  {
    "name": "strings_scan",
    "title": "",
    "description": "提取可打印字符串（ASCII + UTF-16LE）并给文件偏移，可按关键词过滤。用于快速找 URL、命令、注册表、错误信息。",
    "tier": "L0",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "schema": {
      "properties": {
        "grep": {
          "description": "可选子串过滤（大小写不敏感）",
          "type": "string"
        },
        "limit": {
          "description": "最多返回多少条，默认 400",
          "type": "integer"
        },
        "min_len": {
          "description": "最小长度，默认 4",
          "type": "integer"
        },
        "path": {
          "description": "文件路径",
          "type": "string"
        },
        "utf16": {
          "description": "是否同时扫 UTF-16LE，默认 true",
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    }
  },
  {
    "name": "entropy_scan",
    "title": "",
    "description": "计算整体与每节熵，结合节名给出加壳/加密线索（UPX、ASPack、Themida 等）。",
    "tier": "L0",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "schema": {
      "properties": {
        "path": {
          "description": "文件路径",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    }
  },
  {
    "name": "ioc_extract",
    "title": "",
    "description": "从文件或给定文本里抽取 URL/域名/IP/邮箱/哈希/Windows 路径，去重后按类别输出。",
    "tier": "L0",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "schema": {
      "properties": {
        "max_each": {
          "description": "每类最多返回多少条，默认 40",
          "type": "integer"
        },
        "path": {
          "description": "文件路径（与 text 二选一）",
          "type": "string"
        },
        "text": {
          "description": "直接给文本（与 path 二选一）",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "list_assets",
    "title": "资产查询",
    "description": "查资产图。给 query 做关键词检索；给 type 按类型列举（root_domain/ip/subdomain/app/service/endpoint）；给 company_id 或 task_id 按归属过滤；都不给则返回各类型数量概览。",
    "tier": "L1",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "schema": {
      "properties": {
        "company_id": {
          "description": "公司 id",
          "type": "string"
        },
        "query": {
          "description": "关键词（域名、IP、URL、指纹）",
          "type": "string"
        },
        "task_id": {
          "description": "任务 id",
          "type": "string"
        },
        "type": {
          "description": "资产类型",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "list_findings",
    "title": "漏洞查询",
    "description": "分页查历史发现。可按 task_id / severity / status / vuln_class / query 过滤，返回总数与条目（含摘要与证据片段）。",
    "tier": "L1",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "schema": {
      "properties": {
        "page": {
          "description": "页码，默认 1",
          "type": "string"
        },
        "page_size": {
          "description": "每页条数，默认 20，上限 100",
          "type": "string"
        },
        "query": {
          "description": "关键词",
          "type": "string"
        },
        "severity": {
          "description": "critical/high/medium/low",
          "type": "string"
        },
        "status": {
          "description": "pending/confirmed/false_positive/…",
          "type": "string"
        },
        "task_id": {
          "description": "任务 id（字符串）",
          "type": "string"
        },
        "vuln_class": {
          "description": "漏洞分类",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "list_companies",
    "title": "公司/范围",
    "description": "列出公司与其授权范围（domain/CIDR/ICP），以及每家公司的资产数量。",
    "tier": "L1",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "schema": {
      "properties": {},
      "type": "object"
    }
  },
  {
    "name": "list_tasks",
    "title": "任务列表",
    "description": "列出任务（id/名称/状态/分析域/目标摘要），可按 status 过滤。用 get_task 取单个任务详情。",
    "tier": "L1",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "schema": {
      "properties": {
        "limit": {
          "description": "最多返回条数，默认 50",
          "type": "string"
        },
        "status": {
          "description": "created/running/paused/done/failed/timeout",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "get_task",
    "title": "任务详情",
    "description": "按 id 取任务详情，附资产类型计数，便于判断这个目标已经挖到哪一步。",
    "tier": "L1",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "schema": {
      "properties": {
        "id": {
          "description": "任务 id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "name": "task_create",
    "title": "创建任务",
    "description": "把一个目标交给 ARTEX 后台任务。description 写清范围与约束，goal 写要达成的验证目标。返回 task_id，用 task_status 跟进。属于写操作，仅在 L3 开启时可用。",
    "tier": "L3",
    "read_only": false,
    "destructive": false,
    "idempotent": false,
    "open_world": true,
    "schema": {
      "properties": {
        "analysis_domain": {
          "description": "分析域，默认 web_security",
          "enum": [
            "web_security",
            "software_re"
          ],
          "type": "string"
        },
        "company_ids": {
          "description": "可选：归属公司 id",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "description": {
          "description": "任务描述：目标范围、授权边界、已知线索",
          "type": "string"
        },
        "goal": {
          "description": "验证目标，例如『确认 /api/user 是否存在越权读取』",
          "type": "string"
        },
        "name": {
          "description": "可选任务名",
          "type": "string"
        },
        "timeout_seconds": {
          "description": "任务超时秒数，默认 0（不限）",
          "type": "integer"
        },
        "token_budget": {
          "description": "token 预算，默认 0（不限）",
          "type": "integer"
        }
      },
      "required": [
        "description",
        "goal"
      ],
      "type": "object"
    }
  },
  {
    "name": "task_status",
    "title": "任务进度",
    "description": "查任务状态、进度与产出数量（资产/发现），用于轮询自己刚创建的任务。",
    "tier": "L3",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "schema": {
      "properties": {
        "id": {
          "description": "任务 id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "name": "task_pause",
    "title": "暂停任务",
    "description": "暂停一个正在运行的任务（可再用 task_resume 恢复）。不删除任何数据。",
    "tier": "L3",
    "read_only": false,
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "schema": {
      "properties": {
        "id": {
          "description": "任务 id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "name": "task_resume",
    "title": "恢复任务",
    "description": "恢复一个被暂停的任务。",
    "tier": "L3",
    "read_only": false,
    "destructive": false,
    "idempotent": false,
    "open_world": false,
    "schema": {
      "properties": {
        "id": {
          "description": "任务 id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "name": "artex_status",
    "title": "ARTEX 态势",
    "description": "查 ARTEX 本体的运行态势：活动任务、全部任务及状态、运行/排队/暂停计数、并发上限。想知道 ARTEX 现在在干什么、能干什么，先调这个——不要读源码、不要翻文档、不要猜。",
    "tier": "L3",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "schema": {
      "properties": {
        "include_done": {
          "description": "是否包含已结束（done/failed/timeout）的任务，默认 false",
          "type": "boolean"
        },
        "limit": {
          "description": "最多返回多少个任务，默认 20，上限 50",
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "task_steer",
    "title": "给任务下指令",
    "description": "任务跑偏、需要补充约束或新增方向时，把一段人类指令注入任务。mode=hint（默认）记为提示节点，planner 下一轮会读到；mode=intent 直接插入一条高优先级意图，planner 优先处理。不暂停任务、不删除数据。",
    "tier": "L3",
    "read_only": false,
    "destructive": false,
    "idempotent": false,
    "open_world": true,
    "schema": {
      "properties": {
        "id": {
          "description": "任务 id（task_create 返回的 task_id）",
          "type": "integer"
        },
        "mode": {
          "description": "hint=提示（默认）；intent=高优先级意图",
          "enum": [
            "hint",
            "intent"
          ],
          "type": "string"
        },
        "text": {
          "description": "要补充的方向、约束或验收标准；写具体，不要写『继续加油』",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "type": "object"
    }
  }
]
