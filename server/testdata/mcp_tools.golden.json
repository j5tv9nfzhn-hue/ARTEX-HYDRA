      ],
      "type": "object"
    }
  },
  {
    "name": "dns_recon",
    "title": "",
    "description": "解析域名的 A/AAAA/CNAME/MX/TXT/NS，可选常见子域爆破。用于确认资产归属与邮件/验证配置。",
    "tier": "L2",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": true,
    "schema": {
      "properties": {
        "brute": {
          "description": "是否用内置常见前缀做子域探测（默认 false，会发几十次 DNS 查询）",
          "type": "boolean"
        },
        "domain": {
          "description": "根域名，例如 example.com",
          "type": "string"
        },
        "timeout_ms": {
          "description": "单次解析超时毫秒，默认 3000",
          "type": "integer"
        },
        "wordlist": {
          "description": "自定义子域前缀列表，给了就代替内置列表",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "domain"
      ],
      "type": "object"
    }
  },
  {
    "name": "port_probe",
    "title": "",
    "description": "TCP connect 探活（不是 SYN 扫描，不发原始包），可读首个 banner。支持 80,443,8000-8100 这种写法。",
    "tier": "L2",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": true,
    "schema": {
      "properties": {
        "banner": {
          "description": "是否读取首个 banner（默认 true）",
          "type": "boolean"
        },
        "concurrency": {
          "description": "并发数，默认 128，上限 512",
          "type": "integer"
        },
        "host": {
          "description": "主机名或 IP",
          "type": "string"
        },
        "ports": {
          "description": "端口表达式：80,443,1000-1010；默认 21,22,23,25,53,80,110,135,139,143,443,445,1433,1521,3306,3389,5432,6379,8080,8443,9000,9200,11211,27017",
          "type": "string"
        },
        "timeout_ms": {
          "description": "单个端口超时毫秒，默认 800",
          "type": "integer"
        }
      },
      "required": [
        "host"
      ],
      "type": "object"
    }
  },
  {
    "name": "tls_inspect",
    "title": "",
    "description": "握手并输出证书链（主体/签发者/SAN/有效期）、协议版本、加密套件、ALPN、是否自签名。排查证书泄露的子域与过期配置。",
