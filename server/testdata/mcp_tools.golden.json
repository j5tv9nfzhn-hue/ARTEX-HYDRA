  {
    "name": "task_create",
    "title": "创建任务",
    "description": "把一个目标交给 ARTEX 后台任务。description 写清范围与约束，goal 写要达成的验证目标。返回 task_id，用 task_status 跟进。属于写操作，仅在 L3 开启时可用。",
    "tier": "L3",
    "read_only": false,
    "destructive": false,
    "idempotent": false,
    "open_world": true,
    "schema": {
      "properties": {
        "analysis_domain": {
          "description": "分析域，默认 web_security",
          "enum": [
            "web_security",
            "software_re"
          ],
          "type": "string"
        },
        "company_ids": {
          "description": "可选：归属公司 id",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "description": {
          "description": "任务描述：目标范围、授权边界、已知线索",
          "type": "string"
        },
        "goal": {
          "description": "验证目标，例如『确认 /api/user 是否存在越权读取』",
          "type": "string"
        },
        "name": {
          "description": "可选任务名",
          "type": "string"
        },
        "timeout_seconds": {
          "description": "任务超时秒数，默认 0（不限）",
          "type": "integer"
        },
        "token_budget": {
          "description": "token 预算，默认 0（不限）",
          "type": "integer"
        }
      },
      "required": [
        "description",
        "goal"
      ],
      "type": "object"
    }
  },
