{
  "name": "artex-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build:android": "expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease",
    "build:ios:sim": "expo prebuild --platform ios --no-install && xcodebuild -workspace ios/*.xcworkspace -scheme $(ls ios | head -1) -sdk iphonesimulator -configuration Release build"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "expo": "^55.0.0",
    "expo-constants": "~18.0.0",
    "expo-linking": "~8.0.0",
    "expo-notifications": "~0.33.0",
    "expo-router": "~7.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.19.0",
    "react-native-svg": "~15.14.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.0"
  }
}
