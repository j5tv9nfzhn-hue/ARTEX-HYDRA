{
  "expo": {
    "name": "ARTEX 总控台",
    "slug": "artex-mobile",
    "version": "1.0.1",
    "scheme": "artex",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0B0E14",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.artex.mobile",
      "buildNumber": "2",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "app.artex.mobile",
      "edgeToEdgeEnabled": true,
      "versionCode": 2,
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "ARTEX 只用相机扫描电脑上的配对二维码，不会拍照或上传。"
        }
      ],
      "./plugins/with-cleartext-lan"
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    }
  }
}
