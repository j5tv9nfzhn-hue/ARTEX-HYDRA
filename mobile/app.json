{
  "expo": {
    "name": "ARTEX 总控台",
    "slug": "artex-mobile",
    "version": "1.0.0",
    "scheme": "artex",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0B0E14",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.artex.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "app.artex.mobile",
      "edgeToEdgeEnabled": true,
      "versionCode": 1,
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    }
  }
}
